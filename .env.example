# Copiez ce fichier vers .env puis changez le mot de passe.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me
ODOO_PORT=8069
# Version d'Odoo : 17, 18 ou 19 (image officielle odoo:<version>).
ODOO_VERSION=19
# Image personnalisée (facultatif) : odoo:<version> + paquets Python de requirements.txt.
# Décommentez la ligne de votre système (séparateur « : » sous Linux/macOS, « ; » sous Windows).
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
# COMPOSE_FILE=docker-compose.yml;docker-compose.build.yml
